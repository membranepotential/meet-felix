# The deployment's own values. Copy this file to `.env` (git-ignored) and fill it in;
# `pnpm run wrangler:config` puts them into `wrangler.local.toml`. Secrets do not belong here:
# they go into `wrangler secret put` and, for local runs, `.dev.vars`. Quote a value that
# contains ` #`, which otherwise starts a comment.

# The Worker's workers.dev origin, where the SFU's adapters deliver recorded audio.
RECORDER_ORIGIN=https://meet-felix.<your-subdomain>.workers.dev
# The id that `pnpm exec wrangler kv namespace create MEETINGS` prints.
MEETINGS_KV_ID=<kv-namespace-id>
# Your display name, prefilled when you join a meeting as host.
OWNER_NAME=<your name>
